{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theme/banner",
	"title": "Banner",
	"category": "theme",
	"description": "Een banner met een afbeelding, titel en tekst.",
	"supports": {
		"align": [ "full" ],
		"html": false
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor-style.css",
	"style": "file:./style.css"
}
