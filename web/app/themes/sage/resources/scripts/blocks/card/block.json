{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theme/card",
	"title": "Kaart",
	"category": "theme",
	"description": "Gebruik dit blok om een kaart te maken met een afbeelding, titel en tekst.",
	"supports": {
		"html": false
	},
	"attributes": {
		"imageId": {
			"type": "number",
			"default": 0
		},
		"focalPoint": {
			"type": "object",
			"default": { "x": 0.5, "y": 0.5 }
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor-style.css",
	"style": "file:./style.css"
}
