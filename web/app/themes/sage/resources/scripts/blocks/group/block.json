{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theme/group",
	"title": "Groep",
	"category": "theme",
	"description": "Gebruik dit blok om bepaalde inhoud uit te lichten.",
	"supports": {
		"align": [ "wide" ],
		"color": {
			"background": true,
			"text": false,
			"__experimentalDefaultControls": {
				"background": true
			}
		},
		"html": false
	},
	"attributes": {},
	"variations": [
		{
			"name": "theme/group-default",
			"title": "Groep",
			"isDefault": true,
			"attributes": {
				"backgroundColor": "primary-100"
			},
			"innerBlocks": [ [ "core/paragraph" ] ]
		}
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor-style.css",
	"style": "file:./style.css"
}
