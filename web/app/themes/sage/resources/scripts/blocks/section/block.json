{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theme/section",
	"title": "Sectie",
	"category": "theme",
	"description": "Gebruik dit blok om pagina onderdelen te groeperen en te structureren.",
	"supports": {
		"anchor": true,
		"color": {
			"background": true,
			"__experimentalDefaultControls": {
				"background": true
			}
		},
		"html": false,
		"spacing": {
			"padding": [ "vertical" ]
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor-style.css",
	"style": "file:./style.css"
}
